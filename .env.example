# Copy to .env and adjust. Every value below has a working default for local development;
# docker compose works without a .env file at all.

# --- App ---
APP_ENV=development              # development | test | production
LOG_LEVEL=INFO

# --- Postgres (used by docker compose to create the database) ---
POSTGRES_USER=propvisit
POSTGRES_PASSWORD=propvisit
POSTGRES_DB=propvisit

# --- Backend connections (for running the backend outside Docker) ---
# Plain postgres:// / postgresql:// URLs (as Supabase and Render hand out) are accepted too.
DATABASE_URL=postgresql+asyncpg://propvisit:propvisit@localhost:5432/propvisit
DB_POOL_SIZE=5                   # keep pool + overflow under the host's connection cap
DB_MAX_OVERFLOW=5
REDIS_URL=redis://localhost:6379/0   # rediss:// for TLS (e.g. Upstash)

# --- Auth ---
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12                 # ~250 ms per hash; tests use 4
LOGIN_MAX_FAILED_ATTEMPTS=5      # per email, within the lockout window
LOGIN_LOCKOUT_SECONDS=900

# --- HTTP ---
CORS_ORIGINS=http://localhost:5173   # comma-separated
CACHE_ENABLED=true                   # toggle the listings search cache (used by load tests)
SEARCH_CACHE_TTL_SECONDS=60

# --- Images: Supabase Storage (falls back to local disk when unset) ---
UPLOAD_DIR=uploads                   # local fallback storage, served at /uploads
MAX_IMAGE_BYTES=5242880              # 5 MB
MAX_IMAGES_PER_LISTING=10
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=listing-images

# --- Email: Resend (logs emails to the console when unset) ---
RESEND_API_KEY=
EMAIL_FROM=PropVisit <noreply@propvisit.dev>
EMAIL_QUEUE_NAME=emails
APP_URL=http://localhost:5173        # used for links inside emails
RQ_SCHEDULER_INTERVAL_SECONDS=1      # how often retries are polled; 60 on metered Redis
RUN_EMBEDDED_WORKER=false            # run the email worker inside the API container (free hosting)
SEED_ON_START=false                  # docker compose sets this to true

# --- Slot holds ---
SLOT_HOLD_SECONDS=300

# --- Frontend ---
# Leave empty to use same-origin /api (Vite proxy in dev, nginx in Docker).
# Set to the backend URL when deploying frontend and backend separately.
VITE_API_URL=
